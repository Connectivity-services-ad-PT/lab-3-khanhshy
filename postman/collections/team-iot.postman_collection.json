              { "key": "Prefer", "value": "code=200" }
            ],
            "url": {
              "raw": "{{baseUrl}}/telemetry?deviceId=SENSOR-001&limit=1",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry"],
