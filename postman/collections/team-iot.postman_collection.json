{
  "info": {
    "_postman_id": "fit4110-lab03-iot-ingestion",
    "name": "FIT4110 Lab03 - IoT Ingestion Contract Tests",
    "description": "Contract tests synced with contracts/team-iot.openapi.yaml.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('traceId', (pm.environment.get('tracePrefix') || 'fit4110-lab03') + '-' + Date.now());",
          "pm.request.headers.upsert({ key: 'X-Trace-Id', value: pm.variables.get('traceId') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "GET /health - service is alive",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has health fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status', 'ok');",
                  "  pm.expect(json).to.have.property('service');",
                  "  pm.expect(json).to.have.property('time');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /sensors/readings - create temperature reading",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=201" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensors/readings",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "readings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"SENSOR-001\",\n  \"sensorType\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\",\n  \"locationId\": \"ZONE-A-01\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response follows SensorReading schema basics', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('createdAt');",
                  "  pm.expect(json).to.have.property('deviceId');",
                  "  pm.expect(json).to.have.property('sensorType');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /sensors/readings - list readings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=200" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensors/readings?deviceId=SENSOR-001&sensorType=temperature&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "readings"],
              "query": [
                { "key": "deviceId", "value": "SENSOR-001" },
                { "key": "sensorType", "value": "temperature" },
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains paged readings', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('items').that.is.an('array');",
                  "  pm.expect(json).to.have.property('total');",
                  "  pm.expect(json).to.have.property('nextCursor');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /devices/{deviceId}/status - device status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=200" }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices/SENSOR-001/status",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "SENSOR-001", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has device status fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('deviceId');",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(['online', 'offline', 'maintenance']).to.include(json.status);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02_Auth",
      "item": [
        {
          "name": "POST /sensors/readings - valid bearer token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=201" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensors/readings",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "readings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"SENSOR-002\",\n  \"sensorType\": \"humidity\",\n  \"value\": 55.2,\n  \"unit\": \"percent\",\n  \"timestamp\": \"2026-05-13T08:31:00+07:00\",\n  \"locationId\": \"ZONE-A-02\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authorized request returns success', function () { pm.expect(pm.response.code).to.eql(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /sensors/readings - missing token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensors/readings",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "readings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"SENSOR-003\",\n  \"sensorType\": \"motion\",\n  \"value\": 1,\n  \"unit\": \"boolean\",\n  \"timestamp\": \"2026-05-13T08:32:00+07:00\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing token is rejected by real service or documented by mock', function () {",
                  "  if (pm.environment.get('env') === 'mock' || pm.variables.get('localMode') === 'prism-mock') {",
                  "    pm.expect([401, 403, 201]).to.include(pm.response.code);",
                  "  } else {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /sensors/readings - invalid token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer invalid-token" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensors/readings",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "readings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"SENSOR-004\",\n  \"sensorType\": \"temperature\",\n  \"value\": 29.4,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:33:00+07:00\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid token is rejected by real service or documented by mock', function () {",
                  "  if (pm.environment.get('env') === 'mock' || pm.variables.get('localMode') === 'prism-mock') {",
                  "    pm.expect([401, 403, 201]).to.include(pm.response.code);",
                  "  } else {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03_Negative",
      "item": [
        {
          "name": "POST /sensors/readings - missing deviceId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=400" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensors/readings",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "readings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorType\": \"temperature\",\n  \"value\": 31.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid payload returns client error', function () { pm.expect([400, 422]).to.include(pm.response.code); });",
                  "pm.test('Error response has Problem shape', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.within(400, 599);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /sensors/readings - invalid limit",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=400" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensors/readings?limit=101",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "readings"],
              "query": [
                { "key": "limit", "value": "101" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid limit returns client error', function () { pm.expect([400, 422]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04_Boundary_Reliability",
      "item": [
        {
          "name": "POST /sensors/readings - high temperature boundary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=201" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensors/readings",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "readings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"SENSOR-001\",\n  \"sensorType\": \"temperature\",\n  \"value\": 80,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\",\n  \"locationId\": \"ZONE-A-01\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Boundary request has intentional server behavior', function () { pm.expect([201, 400, 422]).to.include(pm.response.code); });",
                  "pm.test('Boundary response is inspectable', function () {",
                  "  const json = pm.response.json();",
                  "  if (pm.response.code === 201) { pm.expect(json).to.have.property('id'); }",
                  "  if ([400, 422].includes(pm.response.code)) { pm.expect(json).to.have.property('detail'); }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /sensors/threshold-exceeded - severity filter",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=200" }
            ],
            "url": {
              "raw": "{{baseUrl}}/sensors/threshold-exceeded?severity=HIGH&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["sensors", "threshold-exceeded"],
              "query": [
                { "key": "severity", "value": "HIGH" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains threshold event list', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('items').that.is.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
